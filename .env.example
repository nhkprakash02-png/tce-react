# Copy this file to .env and fill in your Firebase project's config.
# (Values already have working fallback defaults in src/firebase.js matching the live
# tce-nahata project, but env vars are the safer long-term place to keep them.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
